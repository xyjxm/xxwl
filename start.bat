@echo off
setlocal
cd /d "%~dp0"

rem "-----改成自己的quanser路径-----"
set "PROJECT_DIR=%~dp0"
set "PYTHON_PATH=%PROJECT_DIR%quanser"
set "PYTHONPATH=%PROJECT_DIR%python;%PYTHONPATH%"
set "QAL_DIR=%PROJECT_DIR%"
set "RTMODELS_DIR=%PROJECT_DIR%rtmodels"

call :showLogo
pause

"%PYTHON_PATH%\python.exe" ".\CompetitionGUI.py"

pause

:showLogo
if not exist .outlogo (
echo  >.logo
certutil -decode .logo .outlogo>nul
del .logo
)
type .outlogo
goto :eof
